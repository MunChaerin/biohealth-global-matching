OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 서버 전용 Supabase 설정. SUPABASE_SECRET_KEY에는 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 카메라 표정 결과 API(/api/camera)는 데모 전용. 배포(production)에서 쓰려면 true로 설정
CAMERA_DEMO_MODE=

# 알약 인식 모델 위치 (비워 두면 /models/pill/pill_classifier.onnx)
NEXT_PUBLIC_PILL_MODEL_URL=
